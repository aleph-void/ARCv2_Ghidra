l_rb_p: l_bp_lo_6 is l_b_hi=6 & l_bp_lo_6 & l_be_lo_6 & l_bo_lo_6 { local v:8 = (zext(l_bo_lo_6) << 32) | zext(l_be_lo_6); export v; }
l_rb_p: l_bp_lo_7 is l_b_hi=7 & l_bp_lo_7 & l_be_lo_7 & l_bo_lo_7 { local v:8 = (zext(l_bo_lo_7) << 32) | zext(l_be_lo_7); export v; }
l_rb_e: l_be_lo_0 is l_b_hi=0 & l_be_lo_0 { export l_be_lo_0; }
l_rb_o: l_bo_lo_0 is l_b_hi=0 & l_bo_lo_0 { export l_bo_lo_0; }
l_rb_e: l_be_lo_1 is l_b_hi=1 & l_be_lo_1 { export l_be_lo_1; }
l_rb_o: l_bo_lo_1 is l_b_hi=1 & l_bo_lo_1 { export l_bo_lo_1; }
l_rb_e: l_be_lo_2 is l_b_hi=2 & l_be_lo_2 { export l_be_lo_2; }
l_rb_o: l_bo_lo_2 is l_b_hi=2 & l_bo_lo_2 { export l_bo_lo_2; }
l_rb_e: l_be_lo_3 is l_b_hi=3 & l_be_lo_3 { export l_be_lo_3; }
l_rb_o: l_bo_lo_3 is l_b_hi=3 & l_bo_lo_3 { export l_bo_lo_3; }
l_rb_e: l_be_lo_4 is l_b_hi=4 & l_be_lo_4 { export l_be_lo_4; }
l_rb_o: l_bo_lo_4 is l_b_hi=4 & l_bo_lo_4 { export l_bo_lo_4; }
l_rb_e: l_be_lo_5 is l_b_hi=5 & l_be_lo_5 { export l_be_lo_5; }
l_rb_o: l_bo_lo_5 is l_b_hi=5 & l_bo_lo_5 { export l_bo_lo_5; }
l_rb_e: l_be_lo_6 is l_b_hi=6 & l_be_lo_6 { export l_be_lo_6; }
l_rb_o: l_bo_lo_6 is l_b_hi=6 & l_bo_lo_6 { export l_bo_lo_6; }
l_rb_e: l_be_lo_7 is l_b_hi=7 & l_be_lo_7 { export l_be_lo_7; }
l_rb_o: l_bo_lo_7 is l_b_hi=7 & l_bo_lo_7 { export l_bo_lo_7; }
s_hn: s_h_lo_0 is s_h_hi=0 & s_h_lo_0 { export s_h_lo_0; }
s_h: s_h_lo_0 is s_h_hi=0 & s_h_lo_0 { export s_h_lo_0; }
s_g: s_g_lo_0 is s_g_hi=0 & s_g_lo_0 { export s_g_lo_0; }
s_hn: s_h_lo_1 is s_h_hi=1 & s_h_lo_1 { export s_h_lo_1; }
s_h: s_h_lo_1 is s_h_hi=1 & s_h_lo_1 { export s_h_lo_1; }
s_g: s_g_lo_1 is s_g_hi=1 & s_g_lo_1 { export s_g_lo_1; }
s_hn: s_h_lo_2 is s_h_hi=2 & s_h_lo_2 { export s_h_lo_2; }
s_h: s_h_lo_2 is s_h_hi=2 & s_h_lo_2 { export s_h_lo_2; }
s_g: s_g_lo_2 is s_g_hi=2 & s_g_lo_2 { export s_g_lo_2; }
s_hn: s_h_lo_3 is s_h_hi=3 & s_h_lo!=6 & s_h_lo_3 { export s_h_lo_3; }
s_h: s_h_lo_3 is s_h_hi=3 & s_h_lo_3 { export s_h_lo_3; }
s_g: s_g_lo_3 is s_g_hi=3 & s_g_lo_3 { export s_g_lo_3; }

limm: v is limm_hi ; limm_lo [ v = (limm_hi << 16) | limm_lo; ] { export *[const]:4 v; }
pclv: "pcl" is epsilon { local v:4 = inst_start & 0xfffffffc; export v; }

l_b_src: limm is l_b_hi=7 & l_b_lo=6 ; limm { export limm; }
l_b_src: pclv is l_b_hi=7 & l_b_lo=7 & pclv { export pclv; }
l_b_src: l_rb is l_rb { export l_rb; }
l_b_dst: l_rb is l_rb { export l_rb; }
l_b_dst: "0" is l_b_hi=7 & l_b_lo=6 { local t:4 = 0; export t; }

l_c_src: limm is l_c=62 ; limm { export limm; }
l_c_src: pclv is l_c=63 & pclv { export pclv; }
l_c_src: l_c_r is l_c_r { export l_c_r; }

l_a_dst: l_a_r is l_a_r { export l_a_r; }
l_a_dst: "0" is l_a=62 { local t:4 = 0; export t; }

# 64-bit (register pair) operands: value = odd:even
l_a_pv: l_a_p is l_a_p & l_a_e & l_a_o { local v:8 = (zext(l_a_o) << 32) | zext(l_a_e); export v; }
l_c_pv: l_c_p is l_c_p & l_c_e & l_c_o { local v:8 = (zext(l_c_o) << 32) | zext(l_c_e); export v; }
l_c_pv: limm is l_c=62 ; limm { local v:8 = sext(limm); export v; }
l_b_pv: l_rb_p is l_rb_p { export l_rb_p; }
l_b_pv: limm is l_b_hi=7 & l_b_lo=6 ; limm { local v:8 = sext(limm); export v; }

# 16-bit h/g register operands (5 bits, h = bits 1..0:7..5); 30 means long immediate (as a
# destination: discard)
s_h_src: limm is s_h_hi=3 & s_h_lo=6 ; limm { export limm; }
s_h_src: s_h is s_h { export s_h; }
s_h_dst: s_h is s_h { export s_h; }
s_h_dst: "0" is s_h_hi=3 & s_h_lo=6 { local t:4 = 0; export t; }
s_g_dst: s_g is s_g { export s_g; }
s_g_dst: "0" is s_g_hi=3 & s_g_lo=6 { local t:4 = 0; export t; }

# General operations (majors 4-6): operands by format (bits 23..22)
#   0: a,b,c   1: a,b,u6   2: b,b,s12   3: <cc> b,b,c (bit 5 = 0) / b,b,u6 (bit 5 = 1)
op_c: l_c_src is l_fmt=0 ... & l_c_src { export l_c_src; }
op_c: l_u6 is l_fmt=1 & l_u6 { export *[const]:4 l_u6; }
op_c: s12 is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { export *[const]:4 s12; }
op_c: l_c_src is (l_fmt=3 & l_M=0) ... & l_c_src { export l_c_src; }
op_c: l_u6 is l_fmt=3 & l_M=1 & l_u6 { export *[const]:4 l_u6; }

op_a: l_a_dst is (l_fmt=0 | l_fmt=1) & l_a_dst { export l_a_dst; }
op_a: l_b_dst is (l_fmt=2 | l_fmt=3) & l_b_dst { export l_b_dst; }

op_b: l_b_src is l_b_src { export l_b_src; }

# The odd register of a 64-bit result (a+1, or b+1 in formats 2/3); objdump prints only the
# first register of these operations (mpyd, FPU double precision)
op_ahi: o is (l_fmt=0 | l_fmt=1) & l_a [ o = (l_a + 1) << 2; ] { export *[register]:4 o; }
op_ahi: is (l_fmt=0 | l_fmt=1) & l_a=62 { local t:4 = 0; export t; }
op_ahi: o is (l_fmt=2 | l_fmt=3) & l_b_hi & l_b_lo [ o = (((l_b_hi << 3) | l_b_lo) + 1) << 2; ] { export *[register]:4 o; }
op_ahi: is (l_fmt=2 | l_fmt=3) & l_b_hi=7 & l_b_lo=6 { local t:4 = 0; export t; }
op_bhi: o is l_b_hi & l_b_lo [ o = (((l_b_hi << 3) | l_b_lo) + 1) << 2; ] { export *[register]:4 o; }
op_bhi: is l_b_hi=7 & l_b_lo=6 { local t:4 = 0; export t; }
# 64-bit sources from a register and the next one; an immediate is the high word (low word 0)
op_bd: l_rb is l_rb & op_bhi { local v:8 = (zext(op_bhi) << 32) | zext(l_rb); export v; }
op_bd: is l_b_hi=7 & l_b_lo=6 ; limm { local v:8 = zext(limm) << 32; export v; }
op_chi: o is l_c [ o = (l_c + 1) << 2; ] { export *[register]:4 o; }
op_cd: l_c_r is (l_fmt=0 | (l_fmt=3 & l_M=0)) & l_c_r & op_chi { local v:8 = (zext(op_chi) << 32) | zext(l_c_r); export v; }
op_cd: is (l_fmt=0 | (l_fmt=3 & l_M=0)) & l_c=62 ; limm { local v:8 = zext(limm) << 32; export v; }
op_cd: is (l_fmt=1 | (l_fmt=3 & l_M=1)) & l_u6 { local v:8 = zext(l_u6:4) << 32; export v; }
op_cd: s12 is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { local v:8 = zext(s12:4) << 32; export v; }
# operations objdump decodes without any long immediate or discarded destination
op_nd: is l_fmt=0 & l_a!=62 & l_c!=62 & l_b_hi!=7 { }
op_nd: is l_fmt=0 & l_a!=62 & l_c!=62 & l_b_hi=7 & l_b_lo!=6 { }
op_nd: is l_fmt=1 & l_a!=62 & l_b_hi!=7 { }
op_nd: is l_fmt=1 & l_a!=62 & l_b_hi=7 & l_b_lo!=6 { }
op_nd: is l_fmt=2 & l_b_hi!=7 { }
op_nd: is l_fmt=2 & l_b_hi=7 & l_b_lo!=6 { }
op_nd: is l_fmt=3 & l_M=1 & l_b_hi!=7 { }
op_nd: is l_fmt=3 & l_M=1 & l_b_hi=7 & l_b_lo!=6 { }
op_nd: is l_fmt=3 & l_M=0 & l_c!=62 & l_b_hi!=7 { }
op_nd: is l_fmt=3 & l_M=0 & l_c!=62 & l_b_hi=7 & l_b_lo!=6 { }
# operations objdump does not decode as "0,limm,c" (formats 0 and 1)
op_nab: is l_fmt=2 | l_fmt=3 { }
op_nab: is (l_fmt=0 | l_fmt=1) & l_a!=62 { }
op_nab: is (l_fmt=0 | l_fmt=1) & l_a=62 & l_b_hi!=7 { }
op_nab: is (l_fmt=0 | l_fmt=1) & l_a=62 & l_b_hi=7 & l_b_lo!=6 { }

# 64-bit forms
op_cp: l_c_pv is l_fmt=0 ... & l_c_pv { export l_c_pv; }
op_cp: l_u6 is l_fmt=1 & l_u6 { local v:8 = l_u6; export v; }
op_cp: s12 is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { local v:8 = s12; export v; }
op_cp: l_c_pv is (l_fmt=3 & l_M=0) ... & l_c_pv { export l_c_pv; }
op_cp: l_u6 is l_fmt=3 & l_M=1 & l_u6 { local v:8 = l_u6; export v; }
# the c operand printed as a single register although the operation reads a pair
op_cp1: l_c_r is l_fmt=3 & l_M=0 & l_c_r { local v:8 = zext(l_c_r); export v; }
op_cp1: limm is l_fmt=3 & l_M=0 & l_c=62 ; limm { local v:8 = sext(limm); export v; }
op_cp1: l_u6 is l_fmt=3 & l_M=1 & l_u6 { local v:8 = l_u6; export v; }

# destination register pair: a (formats 0/1) or b (formats 2/3); written as even, odd
op_ap: l_a_p is (l_fmt=0 | l_fmt=1) & l_a_p & l_a_e & l_a_o { export l_a_e; }
op_ap: "0" is (l_fmt=0 | l_fmt=1) & l_a=62 { local t:4 = 0; export t; }
op_ap: "0" is (l_fmt=2 | l_fmt=3) & l_b_hi=7 & l_b_lo=6 { local t:4 = 0; export t; }
op_ap: l_rb_p is (l_fmt=2 | l_fmt=3) & l_rb_p & l_rb_e { export l_rb_e; }
op_ap1: l_a_e is (l_fmt=0 | l_fmt=1) & l_a_e & l_a_o { export l_a_e; }
op_ap1: l_rb_e is (l_fmt=2 | l_fmt=3) & l_rb_e & l_rb_o { export l_rb_e; }
op_ao: is (l_fmt=0 | l_fmt=1) & l_a_o { export l_a_o; }
op_ao: is (l_fmt=0 | l_fmt=1) & l_a=62 { local t:4 = 0; export t; }
op_ao: is (l_fmt=2 | l_fmt=3) & l_b_hi=7 & l_b_lo=6 { local t:4 = 0; export t; }
op_ao: is (l_fmt=2 | l_fmt=3) & l_rb_o { export l_rb_o; }
op_bp: l_b_pv is l_b_pv { export l_b_pv; }
op_bp1: l_rb_e is l_rb_e & l_rb_o { local v:8 = (zext(l_rb_o) << 32) | zext(l_rb_e); export v; }
op_bp1: limm is l_b_hi=7 & l_b_lo=6 ; limm { local v:8 = sext(limm); export v; }


# Delay-slot suffix
nd: "" is l_N=0 { }
nd: ".d" is l_N=1 { }

define pcodeop ext_condition;
define pcodeop sleep;
define pcodeop swi;
define pcodeop trap_s;
define pcodeop brk;
define pcodeop unimp_s;
define pcodeop sync;
define pcodeop dsync;
define pcodeop dmb;
define pcodeop seti;
define pcodeop clri;
define pcodeop wevt;
define pcodeop wlfc;
define pcodeop rtie;
define pcodeop kflag;
define pcodeop prefetch;
define pcodeop ei;

attach variables [ s_R2 ] [ r0 r1 r2 r3 ];

macro push4(x) {
  local v:4 = x;
  sp = sp - 4;
  *:4 sp = v;
}
macro pop4(x) {
  x = *:4 sp;
  sp = sp + 4;
}
macro cmpflags(vb, vc) {
  local vr:4 = vb - vc;
  Z = vb == vc;
  N = vr s< 0;
  C = vb < vc;
  V = sborrow(vb, vc);
}
# flag: write STATUS32 (aux 0x0a); Z, N, C, V are its bits 11..8
macro set_status(v) {
  *[AUX_REGS_BASE]:4 0x28:4 = v;
  V = (v & 0x100) != 0;
  C = (v & 0x200) != 0;
  N = (v & 0x400) != 0;
  Z = (v & 0x800) != 0;
}

macro zn(v) {
  Z = v == 0;
  N = v s< 0;
}

# Conditions (true when the instruction executes). ccd: ".cc" suffix; ccn: "cc" suffix
# (b, bl, j, jl, lp). Conditions 16-31 are core-specific extensions; objdump names 21, 23
# and 24 and prints nothing for the others, Ghidra prints "e<number>".
ccd: "" is l_cond=0 { local t:1 = 1; export t; }
ccd: ".eq" is l_cond=1 { export Z; }
ccd: ".ne" is l_cond=2 { local t:1 = !Z; export t; }
ccd: ".p" is l_cond=3 { local t:1 = !N; export t; }
ccd: ".n" is l_cond=4 { export N; }
ccd: ".c" is l_cond=5 { export C; }
ccd: ".nc" is l_cond=6 { local t:1 = !C; export t; }
ccd: ".v" is l_cond=7 { export V; }
ccd: ".nv" is l_cond=8 { local t:1 = !V; export t; }
ccd: ".gt" is l_cond=9 { local t:1 = !Z && (N == V); export t; }
ccd: ".ge" is l_cond=10 { local t:1 = N == V; export t; }
ccd: ".lt" is l_cond=11 { local t:1 = N != V; export t; }
ccd: ".le" is l_cond=12 { local t:1 = Z || (N != V); export t; }
ccd: ".hi" is l_cond=13 { local t:1 = !C && !Z; export t; }
ccd: ".ls" is l_cond=14 { local t:1 = C || Z; export t; }
ccd: ".pnz" is l_cond=15 { local t:1 = !N && !Z; export t; }
ccd: ".e16" is l_cond=16 { local t:1 = ext_condition(16:1); export t; }
ccd: ".e17" is l_cond=17 { local t:1 = ext_condition(17:1); export t; }
ccd: ".e18" is l_cond=18 { local t:1 = ext_condition(18:1); export t; }
ccd: ".e19" is l_cond=19 { local t:1 = ext_condition(19:1); export t; }
ccd: ".e20" is l_cond=20 { local t:1 = ext_condition(20:1); export t; }
ccd: ".nj" is l_cond=21 { local t:1 = ext_condition(21:1); export t; }
ccd: ".e22" is l_cond=22 { local t:1 = ext_condition(22:1); export t; }
ccd: ".nm" is l_cond=23 { local t:1 = ext_condition(23:1); export t; }
ccd: ".nt" is l_cond=24 { local t:1 = ext_condition(24:1); export t; }
ccd: ".e25" is l_cond=25 { local t:1 = ext_condition(25:1); export t; }
ccd: ".e26" is l_cond=26 { local t:1 = ext_condition(26:1); export t; }
ccd: ".e27" is l_cond=27 { local t:1 = ext_condition(27:1); export t; }
ccd: ".e28" is l_cond=28 { local t:1 = ext_condition(28:1); export t; }
ccd: ".e29" is l_cond=29 { local t:1 = ext_condition(29:1); export t; }
ccd: ".e30" is l_cond=30 { local t:1 = ext_condition(30:1); export t; }
ccd: ".e31" is l_cond=31 { local t:1 = ext_condition(31:1); export t; }
ccn: "eq" is l_cond=1 { export Z; }
ccn: "ne" is l_cond=2 { local t:1 = !Z; export t; }
ccn: "p" is l_cond=3 { local t:1 = !N; export t; }
ccn: "n" is l_cond=4 { export N; }
ccn: "c" is l_cond=5 { export C; }
ccn: "nc" is l_cond=6 { local t:1 = !C; export t; }
ccn: "v" is l_cond=7 { export V; }
ccn: "nv" is l_cond=8 { local t:1 = !V; export t; }
ccn: "gt" is l_cond=9 { local t:1 = !Z && (N == V); export t; }
ccn: "ge" is l_cond=10 { local t:1 = N == V; export t; }
ccn: "lt" is l_cond=11 { local t:1 = N != V; export t; }
ccn: "le" is l_cond=12 { local t:1 = Z || (N != V); export t; }
ccn: "hi" is l_cond=13 { local t:1 = !C && !Z; export t; }
ccn: "ls" is l_cond=14 { local t:1 = C || Z; export t; }
ccn: "pnz" is l_cond=15 { local t:1 = !N && !Z; export t; }
ccn: "e16" is l_cond=16 { local t:1 = ext_condition(16:1); export t; }
ccn: "e17" is l_cond=17 { local t:1 = ext_condition(17:1); export t; }
ccn: "e18" is l_cond=18 { local t:1 = ext_condition(18:1); export t; }
ccn: "e19" is l_cond=19 { local t:1 = ext_condition(19:1); export t; }
ccn: "e20" is l_cond=20 { local t:1 = ext_condition(20:1); export t; }
ccn: "nj" is l_cond=21 { local t:1 = ext_condition(21:1); export t; }
ccn: "e22" is l_cond=22 { local t:1 = ext_condition(22:1); export t; }
ccn: "nm" is l_cond=23 { local t:1 = ext_condition(23:1); export t; }
ccn: "nt" is l_cond=24 { local t:1 = ext_condition(24:1); export t; }
ccn: "e25" is l_cond=25 { local t:1 = ext_condition(25:1); export t; }
ccn: "e26" is l_cond=26 { local t:1 = ext_condition(26:1); export t; }
ccn: "e27" is l_cond=27 { local t:1 = ext_condition(27:1); export t; }
ccn: "e28" is l_cond=28 { local t:1 = ext_condition(28:1); export t; }
ccn: "e29" is l_cond=29 { local t:1 = ext_condition(29:1); export t; }
ccn: "e30" is l_cond=30 { local t:1 = ext_condition(30:1); export t; }
ccn: "e31" is l_cond=31 { local t:1 = ext_condition(31:1); export t; }
ccx: "" is l_cond=0 { local t:1 = 1; export t; }
ccx: "eq" is l_cond=1 { export Z; }
ccx: "ne" is l_cond=2 { local t:1 = !Z; export t; }
ccx: "p" is l_cond=3 { local t:1 = !N; export t; }
ccx: "n" is l_cond=4 { export N; }
ccx: "c" is l_cond=5 { export C; }
ccx: "nc" is l_cond=6 { local t:1 = !C; export t; }
ccx: "v" is l_cond=7 { export V; }
ccx: "nv" is l_cond=8 { local t:1 = !V; export t; }
ccx: "gt" is l_cond=9 { local t:1 = !Z && (N == V); export t; }
ccx: "ge" is l_cond=10 { local t:1 = N == V; export t; }
ccx: "lt" is l_cond=11 { local t:1 = N != V; export t; }
ccx: "le" is l_cond=12 { local t:1 = Z || (N != V); export t; }
ccx: "hi" is l_cond=13 { local t:1 = !C && !Z; export t; }
ccx: "ls" is l_cond=14 { local t:1 = C || Z; export t; }
ccx: "pnz" is l_cond=15 { local t:1 = !N && !Z; export t; }
ccx: "e16" is l_cond=16 { local t:1 = ext_condition(16:1); export t; }
ccx: "e17" is l_cond=17 { local t:1 = ext_condition(17:1); export t; }
ccx: "e18" is l_cond=18 { local t:1 = ext_condition(18:1); export t; }
ccx: "e19" is l_cond=19 { local t:1 = ext_condition(19:1); export t; }
ccx: "e20" is l_cond=20 { local t:1 = ext_condition(20:1); export t; }
ccx: ".nj" is l_cond=21 { local t:1 = ext_condition(21:1); export t; }
ccx: "e22" is l_cond=22 { local t:1 = ext_condition(22:1); export t; }
ccx: ".nm" is l_cond=23 { local t:1 = ext_condition(23:1); export t; }
ccx: ".nt" is l_cond=24 { local t:1 = ext_condition(24:1); export t; }
ccx: "e25" is l_cond=25 { local t:1 = ext_condition(25:1); export t; }
ccx: "e26" is l_cond=26 { local t:1 = ext_condition(26:1); export t; }
ccx: "e27" is l_cond=27 { local t:1 = ext_condition(27:1); export t; }
ccx: "e28" is l_cond=28 { local t:1 = ext_condition(28:1); export t; }
ccx: "e29" is l_cond=29 { local t:1 = ext_condition(29:1); export t; }
ccx: "e30" is l_cond=30 { local t:1 = ext_condition(30:1); export t; }
ccx: "e31" is l_cond=31 { local t:1 = ext_condition(31:1); export t; }

